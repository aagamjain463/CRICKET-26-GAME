  },
  {
    "id": "Commentary.Wicket.005",
    "file": "Commentary_Wicket_005",
    "category": "WICKET",
    "voice": "B",
    "duration": 4.621,
    "text": "That was the right ball at the right time. Full credit to the bowler.",
