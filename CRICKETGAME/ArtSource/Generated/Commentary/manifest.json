  },
  {
    "id": "Commentary.Wicket.Caught.003",
    "file": "Commentary_Wicket_Caught_003",
    "category": "CAUGHT",
    "voice": "A",
    "duration": 3.611,
    "text": "Safe hands under the high ball. The breakthrough arrives.",
