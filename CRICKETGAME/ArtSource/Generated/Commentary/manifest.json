    "id": "Commentary.Result.Win.002",
    "file": "Commentary_Result_Win_002",
    "category": "MATCH_WIN",
    "voice": "A",
    "duration": 3.483,
    "text": "Victory sealed in style! Eclipse Oval erupts!",
