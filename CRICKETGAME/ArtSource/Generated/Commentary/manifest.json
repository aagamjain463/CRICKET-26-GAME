    "id": "Commentary.Result.Win.003",
    "file": "Commentary_Result_Win_003",
    "category": "MATCH_WIN",
    "voice": "A",
    "duration": 3.831,
    "text": "The chase is completed! Nerves of steel at the death!",
    "priority": 100
  },
  {
    "id": "Commentary.Result.Win.004",
    "file": "Commentary_Result_Win_004",
    "category": "MATCH_WIN",
    "voice": "B",
    "duration": 4.725,
    "text": "That is how you close out a tight game. Calm heads throughout.",
