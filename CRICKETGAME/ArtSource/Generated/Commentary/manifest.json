  },
  {
    "id": "Commentary.Wicket.Caught.001",
    "file": "Commentary_Wicket_Caught_001",
    "category": "CAUGHT",
    "voice": "A",
    "duration": 3.796,
    "text": "Skied it, and taken! The fielder never looked troubled.",
    "priority": 90
  },
  {
    "id": "Commentary.Wicket.Caught.002",
    "file": "Commentary_Wicket_Caught_002",
    "category": "CAUGHT",
    "voice": "A",
    "duration": 3.634,
    "text": "Gone for the big one, and holes out! What drama.",
