  {
    "id": "Commentary.Analysis.001",
    "file": "Commentary_Analysis_001",
    "category": "ANALYSIS",
    "voice": "B",
    "duration": 5.016,
    "text": "The lengths have been brave. Full is risky, but it buys wickets.",
