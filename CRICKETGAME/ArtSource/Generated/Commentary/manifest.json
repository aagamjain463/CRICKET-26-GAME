[
  {
    "id": "Commentary.Match.Start.001",
    "file": "Commentary_Match_Start_001",
    "category": "MATCH_START",
    "voice": "A",
    "duration": 4.145,
    "text": "Welcome to Eclipse Oval. One over. Everything on the line.",
    "priority": 60
  },
  {
    "id": "Commentary.Match.Start.002",
    "file": "Commentary_Match_Start_002",
    "category": "MATCH_START",
    "voice": "A",
    "duration": 3.947,
    "text": "Six balls a side under lights. This should be a cracker.",
    "priority": 60
  },
  {
    "id": "Commentary.Match.Start.003",
    "file": "Commentary_Match_Start_003",
    "category": "MATCH_START",
    "voice": "A",
    "duration": 4.226,
    "text": "The Super Over is here. No second chances from here on.",
    "priority": 60
  },
  {
    "id": "Commentary.Match.Start.004",
    "file": "Commentary_Match_Start_004",
    "category": "MATCH_START",
    "voice": "A",
    "duration": 3.924,
    "text": "A packed house tonight, and the noise is building already.",
    "priority": 60
  },
  {
    "id": "Commentary.Match.Start.005",
    "file": "Commentary_Match_Start_005",
    "category": "MATCH_START",
    "voice": "B",
    "duration": 5.944,
    "text": "The key is simple. Strike clean from ball one, there is no settling in.",
    "priority": 30
  },
  {
    "id": "Commentary.Match.Start.006",
    "file": "Commentary_Match_Start_006",
    "category": "MATCH_START",
    "voice": "B",
    "duration": 5.956,
    "text": "Bowlers have to back their best ball. There is nowhere to hide in six deliveries.",
    "priority": 30
  },
  {
    "id": "Commentary.Innings.End.001",
    "file": "Commentary_Innings_End_001",
    "category": "INNINGS_BREAK",
    "voice": "A",
    "duration": 3.518,
    "text": "The first six balls are done. The target is set.",
    "priority": 70
  },
  {
    "id": "Commentary.Innings.End.002",
    "file": "Commentary_Innings_End_002",
    "category": "INNINGS_BREAK",
    "voice": "A",
    "duration": 3.982,
    "text": "That is the end of the first innings. Time for the chase.",
    "priority": 70
  },
  {
    "id": "Commentary.Chase.Start.001",
    "file": "Commentary_Chase_Start_001",
    "category": "CHASE_START",
    "voice": "A",
    "duration": 4.098,
    "text": "The equation is clear. Six balls to chase it down.",
    "priority": 70
  },
  {
    "id": "Commentary.Chase.Start.002",
    "file": "Commentary_Chase_Start_002",
    "category": "CHASE_START",
    "voice": "A",
    "duration": 3.727,
    "text": "Here comes the chase. Every ball will swing this match.",
    "priority": 70
  },
  {
    "id": "Commentary.Chase.Start.003",
    "file": "Commentary_Chase_Start_003",
    "category": "CHASE_START",
    "voice": "B",
    "duration": 6.211,
    "text": "Boundaries win chases like this. Ones and twos will not be enough alone.",
    "priority": 35
  },
  {
    "id": "Commentary.Chase.Start.004",
    "file": "Commentary_Chase_Start_004",
    "category": "CHASE_START",
    "voice": "B",
    "duration": 6.095,
    "text": "The bowling side needs dots early. Pressure does strange things in a chase.",
    "priority": 35
  },
  {
    "id": "Commentary.Innings.End.003",
    "file": "Commentary_Innings_End_003",
    "category": "INNINGS_BREAK",
    "voice": "B",
    "duration": 4.11,
    "text": "A defendable total if they bowl with discipline at the death.",
    "priority": 35
  },
  {
    "id": "Commentary.Innings.End.004",
    "file": "Commentary_Innings_End_004",
    "category": "INNINGS_BREAK",
    "voice": "B",
    "duration": 5.19,
    "text": "Both sides know exactly what is needed. No guesswork now.",
    "priority": 35
  },
  {
    "id": "Commentary.PreBall.Generic.001",
    "file": "Commentary_PreBall_Generic_001",
    "category": "PRE_BALL",
    "voice": "A",
    "duration": 2.009,
    "text": "Here comes the bowler once again.",
    "priority": 20
  },
  {
    "id": "Commentary.PreBall.Generic.002",
    "file": "Commentary_PreBall_Generic_002",
    "category": "PRE_BALL",
    "voice": "A",
    "duration": 2.984,
    "text": "The batter takes guard. The field comes in.",
    "priority": 20
  },
  {
    "id": "Commentary.PreBall.Generic.003",
    "file": "Commentary_PreBall_Generic_003",
    "category": "PRE_BALL",
    "voice": "A",
    "duration": 3.715,
    "text": "A quiet word at the top of the mark. Away we go.",
    "priority": 20
  },
  {
    "id": "Commentary.PreBall.Generic.004",
    "file": "Commentary_PreBall_Generic_004",
    "category": "PRE_BALL",
    "voice": "A",
    "duration": 3.692,
    "text": "Huge moment in this over. The crowd senses it too.",
    "priority": 20
  },
  {
    "id": "Commentary.PreBall.Bowler.001",
    "file": "Commentary_PreBall_Bowler_001",
    "category": "BOWLER_BUILDUP",
    "voice": "A",
    "duration": 3.738,
    "text": "The bowler has been excellent tonight. Can he hold his nerve?",
    "priority": 22
  },
  {
    "id": "Commentary.PreBall.Batter.001",
    "file": "Commentary_PreBall_Batter_001",
    "category": "BATTER_BUILDUP",
    "voice": "A",
    "duration": 3.17,
    "text": "The striker is seeing it well. This could travel.",
    "priority": 22
  },
  {
    "id": "Commentary.PreBall.AfterBoundary.001",
    "file": "Commentary_PreBall_AfterBoundary_001",
    "category": "AFTER_BOUNDARY",
    "voice": "A",
    "duration": 3.332,
    "text": "Momentum with the batting side after that boundary.",
    "priority": 24
  },
  {
    "id": "Commentary.PreBall.AfterWicket.001",
    "file": "Commentary_PreBall_AfterWicket_001",
    "category": "AFTER_WICKET",
    "voice": "A",
    "duration": 4.574,
    "text": "A wicket changes everything. The new batter is under instant pressure.",
    "priority": 24
  },
  {
    "id": "Commentary.Pressure.001",
    "file": "Commentary_Pressure_001",
    "category": "PRESSURE",
    "voice": "A",
    "duration": 3.843,
    "text": "The equation is tightening now. Every ball matters.",
    "priority": 55
  },
  {
    "id": "Commentary.Pressure.002",
    "file": "Commentary_Pressure_002",
    "category": "PRESSURE",
    "voice": "A",
    "duration": 3.367,
    "text": "No room for hesitation. The batters have to commit.",
    "priority": 55
  },
  {
    "id": "Commentary.Pressure.003",
    "file": "Commentary_Pressure_003",
    "category": "PRESSURE",
    "voice": "A",
    "duration": 3.367,
    "text": "The bowler knows one loose ball ends the contest.",
    "priority": 55
  },
  {
    "id": "Commentary.Pressure.004",
    "file": "Commentary_Pressure_004",
    "category": "PRESSURE",
    "voice": "B",
    "duration": 4.365,
    "text": "Watch the field. They are guarding one side of the ground now.",
    "priority": 38
  },
  {
    "id": "Commentary.FinalBall.001",
    "file": "Commentary_FinalBall_001",
    "category": "FINAL_BALL",
    "voice": "A",
    "duration": 4.005,
    "text": "One ball left. This is what the whole night has built toward.",
    "priority": 85
  },
  {
    "id": "Commentary.FinalBall.002",
    "file": "Commentary_FinalBall_002",
    "category": "FINAL_BALL",
    "voice": "A",
    "duration": 3.773,
    "text": "The final delivery. Hold your breath around the ground.",
    "priority": 85
  },
  {
    "id": "Commentary.FinalBall.003",
    "file": "Commentary_FinalBall_003",
    "category": "FINAL_BALL",
    "voice": "B",
    "duration": 5.492,
    "text": "A boundary wins it. A dot could defend it. Nothing in between matters.",
    "priority": 40
  },
  {
    "id": "Commentary.FinalBall.004",
    "file": "Commentary_FinalBall_004",
    "category": "FINAL_BALL",
    "voice": "A",
    "duration": 3.889,
    "text": "Last ball of the Super Over. Heroes are made right here.",
    "priority": 85
  },
  {
    "id": "Commentary.Delivery.Fast.001",
    "file": "Commentary_Delivery_Fast_001",
    "category": "DELIVERY",
    "voice": "A",
    "duration": 2.09,
    "text": "Sharp pace, right on the money.",
    "priority": 45
  },
  {
    "id": "Commentary.Delivery.Slower.001",
    "file": "Commentary_Delivery_Slower_001",
    "category": "DELIVERY",
    "voice": "A",
    "duration": 2.647,
    "text": "The slower ball. Cleverly disguised.",
    "priority": 45
  },
  {
    "id": "Commentary.Delivery.Yorker.001",
    "file": "Commentary_Delivery_Yorker_001",
    "category": "DELIVERY",
    "voice": "A",
    "duration": 3.982,
    "text": "Right in the blockhole. Superb execution under pressure.",
    "priority": 50
  },
  {
    "id": "Commentary.Delivery.Short.001",
    "file": "Commentary_Delivery_Short_001",
    "category": "DELIVERY",
    "voice": "A",
    "duration": 3.135,
    "text": "Short and into the body. The batter had to hurry.",
    "priority": 45
  },
  {
    "id": "Commentary.Delivery.GoodLength.001",
    "file": "Commentary_Delivery_GoodLength_001",
    "category": "DELIVERY",
    "voice": "A",
    "duration": 3.239,
    "text": "Lovely length. Asking all the questions.",
    "priority": 42
  },
  {
    "id": "Commentary.Delivery.Excellent.001",
    "file": "Commentary_Delivery_Excellent_001",
    "category": "DELIVERY",
    "voice": "A",
    "duration": 2.856,
    "text": "That is as good as it gets in this format.",
    "priority": 52
  },
  {
    "id": "Commentary.Delivery.Beaten.001",
    "file": "Commentary_Delivery_Beaten_001",
    "category": "DELIVERY",
    "voice": "A",
    "duration": 3.251,
    "text": "Beaten! Past the outside edge by a whisker.",
    "priority": 52
  },
  {
    "id": "Commentary.Delivery.Beaten.002",
    "file": "Commentary_Delivery_Beaten_002",
    "category": "DELIVERY",
    "voice": "A",
    "duration": 3.32,
    "text": "No contact. The bowler wins that little battle.",
    "priority": 52
  },
  {
    "id": "Commentary.Delivery.Outswing.001",
    "file": "Commentary_Delivery_Outswing_001",
    "category": "DELIVERY",
    "voice": "A",
    "duration": 3.727,
    "text": "A hint of movement away. Just enough to cause doubt.",
    "priority": 48
  },
  {
    "id": "Commentary.Delivery.Inswing.001",
    "file": "Commentary_Delivery_Inswing_001",
    "category": "DELIVERY",
    "voice": "A",
    "duration": 3.297,
    "text": "Nipping back in. The stumps were in play there.",
    "priority": 48
  },
  {
    "id": "Commentary.Delivery.Defended.001",
    "file": "Commentary_Delivery_Defended_001",
    "category": "SHOT_DEFENCE",
    "voice": "A",
    "duration": 3.553,
    "text": "Watchfully kept out. Good respect for a good ball.",
    "priority": 40
  },
  {
    "id": "Commentary.Delivery.Driven.001",
    "file": "Commentary_Delivery_Driven_001",
    "category": "SHOT_DRIVE",
    "voice": "A",
    "duration": 3.843,
    "text": "Creamed through the covers. Beautiful shape on that stroke.",
    "priority": 44
  },
  {
    "id": "Commentary.Delivery.Lofted.001",
    "file": "Commentary_Delivery_Lofted_001",
    "category": "SHOT_LOFT",
    "voice": "A",
    "duration": 3.831,
    "text": "He went aerial. High risk, high reward in this format.",
    "priority": 46
  },
  {
    "id": "Commentary.Delivery.Mistimed.001",
    "file": "Commentary_Delivery_Mistimed_001",
    "category": "SHOT_MISTIMED",
    "voice": "A",
    "duration": 2.844,
    "text": "Not off the middle. That could have gone anywhere.",
    "priority": 46
  },
  {
    "id": "Commentary.Dot.001",
    "file": "Commentary_Dot_001",
    "category": "DOT",
    "voice": "A",
    "duration": 2.717,
    "text": "Excellent control. No run there.",
    "priority": 30
  },
  {
    "id": "Commentary.Dot.002",
    "file": "Commentary_Dot_002",
    "category": "DOT",
    "voice": "A",
    "duration": 2.496,
    "text": "A valuable dot ball under pressure.",
    "priority": 30
  },
  {
    "id": "Commentary.Dot.003",
    "file": "Commentary_Dot_003",
    "category": "DOT",
    "voice": "A",
    "duration": 3.785,
    "text": "The bowler wins that contest. Scoreboard stays still.",
    "priority": 30
  },
  {
    "id": "Commentary.Dot.004",
    "file": "Commentary_Dot_004",
    "category": "DOT",
    "voice": "A",
    "duration": 3.529,
    "text": "Tight lines. The batter could not free the arms.",
    "priority": 30
  },
  {
    "id": "Commentary.Dot.005",
    "file": "Commentary_Dot_005",
    "category": "DOT",
    "voice": "B",
    "duration": 4.226,
    "text": "That dot is worth its weight in gold at this stage.",
    "priority": 28
  },
  {
    "id": "Commentary.Dot.006",
    "file": "Commentary_Dot_006",
    "category": "DOT",
    "voice": "A",
    "duration": 2.717,
    "text": "Pressure builds with every scoreless delivery.",
    "priority": 30
  },
  {
    "id": "Commentary.Runs.One.001",
    "file": "Commentary_Runs_One_001",
    "category": "RUNS",
    "voice": "A",
    "duration": 2.868,
    "text": "Worked away for a single. Smart cricket.",
    "priority": 40
  },
  {
    "id": "Commentary.Runs.One.002",
    "file": "Commentary_Runs_One_002",
    "category": "RUNS",
    "voice": "A",
    "duration": 2.693,
    "text": "One run. They keep the scoreboard ticking.",
    "priority": 40
  },
  {
    "id": "Commentary.Runs.One.003",
    "file": "Commentary_Runs_One_003",
    "category": "RUNS",
    "voice": "A",
    "duration": 2.949,
    "text": "Pushed into the gap. A comfortable single.",
    "priority": 40
  },
  {
    "id": "Commentary.Runs.Two.001",
    "file": "Commentary_Runs_Two_001",
    "category": "RUNS",
    "voice": "A",
    "duration": 3.738,
    "text": "Two runs. Superb urgency between the wickets.",
    "priority": 42
  },
  {
    "id": "Commentary.Runs.Two.002",
    "file": "Commentary_Runs_Two_002",
    "category": "RUNS",
    "voice": "A",
    "duration": 3.239,
    "text": "They come back for two. The chase stays alive.",
    "priority": 42
  },
  {
    "id": "Commentary.Runs.Three.001",
    "file": "Commentary_Runs_Three_001",
    "category": "RUNS",
    "voice": "A",
    "duration": 3.146,
    "text": "Three runs! Tremendous commitment in the deep.",
    "priority": 44
  },
  {
    "id": "Commentary.Runs.Edge.001",
    "file": "Commentary_Runs_Edge_001",
    "category": "EDGE",
    "voice": "A",
    "duration": 2.81,
    "text": "Thick edge, and that could have gone anywhere.",
    "priority": 60
  },
  {
    "id": "Commentary.Runs.Edge.002",
    "file": "Commentary_Runs_Edge_002",
    "category": "EDGE",
    "voice": "A",
    "duration": 3.46,
    "text": "Not where the batter intended. A lucky escape.",
    "priority": 60
  },
  {
    "id": "Commentary.Four.001",
    "file": "Commentary_Four_001",
    "category": "FOUR",
    "voice": "A",
    "duration": 3.936,
    "text": "That is beautifully placed. The fielder had no chance.",
    "priority": 70
  },
  {
    "id": "Commentary.Four.002",
    "file": "Commentary_Four_002",
    "category": "FOUR",
    "voice": "A",
    "duration": 2.949,
    "text": "Timed cleanly through the gap. Four runs.",
    "priority": 70
  },
  {
    "id": "Commentary.Four.003",
    "file": "Commentary_Four_003",
    "category": "FOUR",
    "voice": "A",
    "duration": 3.146,
    "text": "He has found the boundary when his side needed it.",
    "priority": 70
  },
  {
    "id": "Commentary.Four.004",
    "file": "Commentary_Four_004",
    "category": "FOUR",
    "voice": "A",
    "duration": 2.74,
    "text": "Crashed away to the rope. What a strike.",
    "priority": 70
  },
  {
    "id": "Commentary.Four.005",
    "file": "Commentary_Four_005",
    "category": "FOUR",
    "voice": "A",
    "duration": 4.435,
    "text": "Pierced the infield perfectly. No need to run for that.",
    "priority": 70
  },
  {
    "id": "Commentary.Four.006",
    "file": "Commentary_Four_006",
    "category": "FOUR",
    "voice": "A",
    "duration": 3.355,
    "text": "Glorious timing. The ball races to the fence.",
    "priority": 70
  },
  {
    "id": "Commentary.Four.007",
    "file": "Commentary_Four_007",
    "category": "FOUR",
    "voice": "A",
    "duration": 3.297,
    "text": "Short and punished. That was asking for trouble.",
    "priority": 70
  },
  {
    "id": "Commentary.Four.008",
    "file": "Commentary_Four_008",
    "category": "FOUR",
    "voice": "A",
    "duration": 3.529,
    "text": "Overpitched, and clinically dispatched to the boundary.",
    "priority": 70
  },
  {
    "id": "Commentary.Four.009",
    "file": "Commentary_Four_009",
    "category": "FOUR",
    "voice": "A",
    "duration": 4.307,
    "text": "Back to back boundaries! The bowler is under real pressure now.",
    "priority": 72
  },
  {
    "id": "Commentary.Four.010",
    "file": "Commentary_Four_010",
    "category": "FOUR",
    "voice": "A",
    "duration": 4.667,
    "text": "Edged, and it flies past the keeper! Fortune favors the brave.",
    "priority": 70
  },
  {
    "id": "Commentary.Four.011",
    "file": "Commentary_Four_011",
    "category": "FOUR",
    "voice": "B",
    "duration": 4.075,
    "text": "The placement was perfect. He barely seemed to hit it.",
    "priority": 42
  },
  {
    "id": "Commentary.Four.012",
    "file": "Commentary_Four_012",
    "category": "FOUR",
    "voice": "B",
    "duration": 4.783,
    "text": "That is smart batting. Using the pace instead of forcing it.",
    "priority": 42
  },
  {
    "id": "Commentary.Six.001",
    "file": "Commentary_Six_001",
    "category": "SIX",
    "voice": "A",
    "duration": 2.995,
    "text": "That is launched high and long. All the way!",
    "priority": 80
  },
  {
    "id": "Commentary.Six.002",
    "file": "Commentary_Six_002",
    "category": "SIX",
    "voice": "A",
    "duration": 2.937,
    "text": "Clean strike. That has gone all the way.",
    "priority": 80
  },
  {
    "id": "Commentary.Six.003",
    "file": "Commentary_Six_003",
    "category": "SIX",
    "voice": "A",
    "duration": 3.274,
    "text": "He picked that up superbly. Into the stands!",
    "priority": 80
  },
  {
    "id": "Commentary.Six.004",
    "file": "Commentary_Six_004",
    "category": "SIX",
    "voice": "A",
    "duration": 2.995,
    "text": "Maximum! Absolutely smoked off the middle.",
    "priority": 80
  },
  {
    "id": "Commentary.Six.005",
    "file": "Commentary_Six_005",
    "category": "SIX",
    "voice": "A",
    "duration": 3.007,
    "text": "That is huge! The crowd is on its feet.",
    "priority": 80
  },
  {
    "id": "Commentary.Six.006",
    "file": "Commentary_Six_006",
    "category": "SIX",
    "voice": "A",
    "duration": 2.798,
    "text": "Straight down the ground. A monster hit.",
    "priority": 80
  },
  {
    "id": "Commentary.Six.007",
    "file": "Commentary_Six_007",
    "category": "SIX",
    "voice": "A",
    "duration": 2.624,
    "text": "What a way to swing the over! Six more.",
    "priority": 80
  },
  {
    "id": "Commentary.Six.008",
    "file": "Commentary_Six_008",
    "category": "SIX",
    "voice": "A",
    "duration": 3.367,
    "text": "Two in a row! This batting is simply breathtaking.",
    "priority": 82
  },
  {
    "id": "Commentary.Six.009",
    "file": "Commentary_Six_009",
    "category": "SIX",
    "voice": "A",
    "duration": 3.646,
    "text": "Picked the length early and deposited it with interest.",
    "priority": 80
  },
  {
    "id": "Commentary.Six.010",
    "file": "Commentary_Six_010",
    "category": "SIX",
    "voice": "A",
    "duration": 3.251,
    "text": "That sounded sweet from the moment it left the bat.",
    "priority": 80
  },
  {
    "id": "Commentary.Six.011",
    "file": "Commentary_Six_011",
    "category": "SIX",
    "voice": "B",
    "duration": 4.156,
    "text": "The extension of the arms there was textbook power hitting.",
    "priority": 45
  },
  {
    "id": "Commentary.Six.012",
    "file": "Commentary_Six_012",
    "category": "SIX",
    "voice": "B",
    "duration": 4.226,
    "text": "He committed to the loft early and backed himself fully.",
    "priority": 45
  },
  {
    "id": "Commentary.Wicket.001",
    "file": "Commentary_Wicket_001",
    "category": "WICKET",
    "voice": "A",
    "duration": 2.38,
    "text": "Gone! That is a huge breakthrough.",
    "priority": 90
  },
  {
    "id": "Commentary.Wicket.002",
    "file": "Commentary_Wicket_002",
    "category": "WICKET",
    "voice": "A",
    "duration": 3.529,
    "text": "The stumps are disturbed, and the bowler has his reward.",
    "priority": 90
  },
  {
    "id": "Commentary.Wicket.003",
    "file": "Commentary_Wicket_003",
    "category": "WICKET",
    "voice": "A",
    "duration": 2.682,
    "text": "That changes this Super Over completely!",
    "priority": 90
  },
  {
    "id": "Commentary.Wicket.Bowled.001",
    "file": "Commentary_Wicket_Bowled_001",
    "category": "BOWLED",
    "voice": "A",
    "duration": 2.74,
    "text": "Bowled him! Right through the gate. Timber!",
    "priority": 90
  },
  {
    "id": "Commentary.Wicket.Bowled.002",
    "file": "Commentary_Wicket_Bowled_002",
    "category": "BOWLED",
    "voice": "A",
    "duration": 3.611,
    "text": "The furniture is rearranged! A perfect yorker.",
