  },
  {
    "id": "Commentary.Result.Loss.003",
    "file": "Commentary_Result_Loss_003",
    "category": "MATCH_LOSS",
    "voice": "B",
    "duration": 4.052,
    "text": "The bowlers owned the big moments, and that made the difference.",
