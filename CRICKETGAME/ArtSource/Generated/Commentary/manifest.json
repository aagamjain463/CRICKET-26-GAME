  },
  {
    "id": "Commentary.Analysis.002",
    "file": "Commentary_Analysis_002",
    "category": "ANALYSIS",
    "voice": "B",
    "duration": 5.027,
    "text": "Notice how straight the field is. They are cutting off the easy single.",
    "priority": 25
  },
  {
    "id": "Commentary.Analysis.003",
    "file": "Commentary_Analysis_003",
    "category": "ANALYSIS",
    "voice": "B",
    "duration": 3.634,
    "text": "Timing matters more than muscle on this surface.",
    "priority": 25
  },
  {
    "id": "Commentary.Analysis.004",
    "file": "Commentary_Analysis_004",
    "category": "ANALYSIS",
    "voice": "B",
    "duration": 4.946,
    "text": "The bowlers are varying pace nicely. Nothing predictable so far.",
    "priority": 25
  },
  {
    "id": "Commentary.Analysis.005",
    "file": "Commentary_Analysis_005",
    "category": "ANALYSIS",
    "voice": "B",
    "duration": 4.063,
    "text": "Batting first here is about intent, not preservation.",
    "priority": 25
  },
  {
    "id": "Commentary.Analysis.006",
    "file": "Commentary_Analysis_006",
    "category": "ANALYSIS",
    "voice": "B",
    "duration": 4.981,
    "text": "Chasing sides love a boundary early. It settles every nerve.",
    "priority": 25
  },
  {
    "id": "Commentary.Analysis.007",
    "file": "Commentary_Analysis_007",
    "category": "ANALYSIS",
    "voice": "B",
    "duration": 4.876,
    "text": "That over shows why yorkers at pace are still gold at the death.",
    "priority": 25
  },
  {
    "id": "Commentary.Analysis.008",
    "file": "Commentary_Analysis_008",
    "category": "ANALYSIS",
    "voice": "B",
    "duration": 4.365,
    "text": "Fielding standards have been sharp. Every run is being earned.",
    "priority": 25
  },
  {
    "id": "Commentary.Analysis.009",
    "file": "Commentary_Analysis_009",
    "category": "ANALYSIS",
    "voice": "B",
    "duration": 5.016,
    "text": "Dot balls are currency in a Super Over. Each one doubles the pressure.",
    "priority": 25
  },
  {
    "id": "Commentary.Analysis.010",
    "file": "Commentary_Analysis_010",
    "category": "ANALYSIS",
    "voice": "B",
    "duration": 5.642,
    "text": "The contact has been clean tonight. The outfield is lightning fast.",
    "priority": 25
  },
  {
    "id": "Commentary.Analysis.011",
    "file": "Commentary_Analysis_011",
    "category": "ANALYSIS",
    "voice": "B",
    "duration": 5.166,
    "text": "Smart bowling change of pace. The batter was through the shot early.",
    "priority": 25
  },
  {
    "id": "Commentary.Analysis.012",
    "file": "Commentary_Analysis_012",
    "category": "ANALYSIS",
    "voice": "B",
    "duration": 4.946,
    "text": "Composure now. The side that stays calm usually takes these.",
    "priority": 25
  },
  {
    "id": "Commentary.Result.Win.001",
    "file": "Commentary_Result_Win_001",
    "category": "MATCH_WIN",
    "voice": "A",
    "duration": 3.332,
    "text": "They have done it! What a finish to this Super Over!",
    "priority": 100
  },
